# ─── LumiLearn Configuration ───

# AI Provider: gemini | openai | anthropic | local
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# API Keys (all optional — system works fully without them)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local model (Ollama-compatible)
LOCAL_MODEL_URL=http://localhost:11434/api/generate

# Token management
MAX_CHUNK_TOKENS=2000

# App
UPLOAD_DIR=./uploads
DATABASE_URL=./lumilearn.db
LOG_LEVEL=INFO
