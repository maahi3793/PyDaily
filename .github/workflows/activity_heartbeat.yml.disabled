name: Activity Heartbeat

on:
  schedule:
    # Runs every 3 days at midnight UTC
    - cron: '0 0 */3 * *'
  workflow_dispatch: # Allow manual trigger

jobs:
  heartbeat:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      
      - name: Update Heartbeat
        run: |
          echo "Last Heartbeat: $(date -u)" > HEARTBEAT.md
          git config --global user.name "PyDaily Bot"
          git config --global user.email "bot@pydaily.ai"
          git add HEARTBEAT.md
          git commit -m "chore: repository heartbeat [automated]" || echo "No changes to commit"
          git push
