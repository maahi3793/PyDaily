name: Boss Battle Scheduler

on:
  schedule:
    # Runs at 09:30 UTC (15:00 IST) -> 3h after Motivation
    - cron: '30 9 * * *'
  workflow_dispatch:

jobs:
  run-boss-cycle:
    runs-on: ubuntu-latest
    
    env:
      SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
      SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}

    steps:
      - uses: actions/checkout@v2
      
      - name: Set up Python
        uses: actions/setup-python@v3
        with:
          python-version: '3.10'
          
      - name: Install Dependencies
        run: pip install -r PyDaily/requirements.txt
      
      # 🚀 EXECUTE BOSS GEN
      - name: Run Boss Generator
        working-directory: ./PyDaily
        run: python scripts/run_boss_cycle.py
